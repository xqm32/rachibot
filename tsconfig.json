{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ESNext"
    ],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": [
      "bun"
    ],
    "esModuleInterop": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  }
}